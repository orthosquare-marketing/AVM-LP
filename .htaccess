RewriteEngine On
SSLProxyEngine on

# ====================================================================
# NEXT.JS REVERSE PROXY RULES WITH BASEPATH
# ====================================================================

# Proxy /10999 and all its prefixed assets/scripts directly to the Next.js subdomain
RewriteRule ^10999$ https://dental-offers-10999.avmsmiles.com/10999 [P,L]
RewriteRule ^10999/(.*)$ https://dental-offers-10999.avmsmiles.com/10999/$1 [P,L]

# ====================================================================
# HOW TO SCALE (To add future offer pages e.g. /20999)
# ====================================================================
# To add a new offer path /20999 pointing to dental-offers-29999.avmsmiles.com,
# simply configure the new Next.js deployment with basePath: '/20999'
# and add the following rules BEFORE any general overrides:
#
# RewriteRule ^20999$ https://dental-offers-29999.avmsmiles.com/20999 [P,L]
# RewriteRule ^20999/(.*)$ https://dental-offers-29999.avmsmiles.com/20999/$1 [P,L]
# ====================================================================
