RewriteEngine On

# Redirect /10999, /10999/, and /10999/index.html on any domain to https://dental-offers-10999.avmsmiles.com/
RewriteRule ^10999/?(index\.html)?$ https://dental-offers-10999.avmsmiles.com/ [R=301,L]

# Rewrite root to /10999/index.html internally for dental-offers-10999.avmsmiles.com
RewriteCond %{HTTP_HOST} ^(www\.)?dental-offers-10999\.avmsmiles\.com$ [NC]
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /10999/index.html [L]
