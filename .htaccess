RewriteEngine On

# If host is dental-offers-10999.avmsmiles.com and path is empty (root /), redirect to /10999
RewriteCond %{HTTP_HOST} ^(www\.)?dental-offers-10999\.avmsmiles\.com$ [NC]
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /10999 [R=301,L]

# If host is NOT dental-offers-10999.avmsmiles.com and path is /10999, redirect to https://dental-offers-10999.avmsmiles.com/10999
RewriteCond %{HTTP_HOST} !^(www\.)?dental-offers-10999\.avmsmiles\.com$ [NC]
RewriteRule ^10999/?$ https://dental-offers-10999.avmsmiles.com/10999 [R=301,L]
